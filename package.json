{
  "name": "dsh-manage-session",
  "version": "2.0.24",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "latest",
    "access": "public"
  },
  "description": "会话控制台：统一管理活跃与已归档会话 —— 归档（archive）视图、按工作区搜索、恢复、删除进回收站（可还原）、按周期压缩归档、四门会话体检。Session console for active and archived sessions: archive view, workspace search, restore, recycle-bin delete, periodic .tar.zst compaction and a four-gate health check. 侧栏入口优先落在顶部工具槽位（插件行之后），否则回落底栏；首屏零 I/O 标题源 + 分帧流式补齐。（原名 dsh-session-steward）",
  "keywords": [
    "archive",
    "archived",
    "archived-sessions",
    "cleanup",
    "deepseek-harness",
    "doctor",
    "dsh",
    "dsh-plugin",
    "favorites",
    "health",
    "manage",
    "manager",
    "recycle-bin",
    "restore",
    "search",
    "session",
    "session-management",
    "sessions",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-manage-session.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -b && tsdown",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && node scripts/check-release.mjs && npm run readme:check",
    "readme:gen": "node scripts/gen-readme.mjs",
    "readme:check": "node scripts/check-readme.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "session-purge": "node scripts/session-purge.mjs",
    "test:client": "node tests/client-store.test.mjs && node --import tsx tests/client-locales.test.mjs && node --import tsx tests/client-open-session.test.mjs && node --import tsx tests/client-sse.test.mjs && node --import tsx tests/client-filter.test.mjs && node --import tsx tests/client-session-actions.test.mjs && node --import tsx tests/client-open-in-app.test.mjs",
    "test:release": "node scripts/check-release.mjs"
  },
  "files": [
    "CHANGELOG.ja.md",
    "CHANGELOG.ko.md",
    "CHANGELOG.pt.md",
    "CHANGELOG.md",
    "INSTALL.ja.md",
