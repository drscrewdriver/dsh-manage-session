{
  "name": "dsh-session-steward",
  "version": "0.5.6-local.16",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "beta",
    "access": "public"
  },
  "description": "DSH Web 插件：会话管家（合并包）—— 会话历史文件（归档浏览与清理）与健康检查（体检 → 处方 → 出院），外加独立 FTS5 会话内容搜索索引（标题/内容双模式、增量同步、非破坏性整理与快照导入导出）。不碰会话日志、只做可逆处置。",
  "keywords": [
    "archive",
    "deepseek-harness",
    "doctor",
    "dsh",
    "dsh-plugin",
    "fts5",
    "health",
    "index",
    "search",
    "session",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-session-steward.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    },
    "pluginDependencies": [
      "dsh-reference-session-collector"
    ]
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -b && tsdown",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && node scripts/check-release.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:client": "node tests/client-store.test.mjs && node tests/client-panel-key.test.mjs && node tests/client-styles.test.mjs && node --import tsx tests/client-platform.test.mjs && node --import tsx tests/client-host-api.test.mjs && node --import tsx tests/client-locales.test.mjs && node --import tsx tests/client-open-session.test.mjs",
    "test:release": "node scripts/check-release.mjs"
  },
  "files": [
    "CHANGELOG.ja.md",
    "CHANGELOG.ko.md",
    "CHANGELOG.md",
    "INSTALL.ja.md",
    "INSTALL.ko.md",
    "INSTALL.md",
    "INSTALL.zh.md",
    "LICENSE",
    "README.en.md",
    "README.ja.md",
    "README.ko.md",
    "README.md",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "lib",
    "locale",
    "screenshots.json",
    "src"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.1.0-rc.2 || 0.1.0-rc.3 || 0.1.0-rc.6 || 0.1.0-rc.7 || 0.1.0-rc.8 || 0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.5-rc.3 || 0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "license": "MIT",
